{
  "name": "lovi",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-production": "ng build --configuration=production --base-href /browser/",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "update-angular": "ng update @angular/core @angular/cli @angular/cdk @angular/localize",
    "update-tailwind": "npx tailwindcss",
    "update-fontawesome": "npm update @fortawesome/angular-fontawesome @fortawesome/free-brands-svg-icons @fortawesome/free-solid-svg-icons"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/service-worker": "^22.0.2",
    "@asteasolutions/epub-reader": "^1.0.4",
    "@fortawesome/angular-fontawesome": "^5.0.0",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@tailwindcss/postcss": "^4.3.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@angular/localize": "^22.0.2",
    "@types/lodash": "^4.17.24",
    "istanbul-lib-instrument": "^6.0.3",
    "postcss": "^8.5.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
