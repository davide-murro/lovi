{
  "name": "lovi",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-production": "ng build --configuration=production --base-href /browser/",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "update-angular": "npm install @angular/cdk @angular/common @angular/compiler @angular/core @angular/forms @angular/platform-browser @angular/router @angular/service-worker @angular/build @angular/cli @angular/compiler-cli @angular/localize",
    "update-tailwind": "npm install tailwindcss @tailwindcss/postcss postcss",
    "update-fontawesome": "npm install @fortawesome/angular-fontawesome @fortawesome/fontawesome-free @fortawesome/free-brands-svg-icons @fortawesome/free-solid-svg-icons",
    "update-all": "npm install @angular/cdk @angular/common @angular/compiler @angular/core @angular/forms @angular/platform-browser @angular/router @angular/service-worker @asteasolutions/epub-reader @fortawesome/angular-fontawesome @fortawesome/fontawesome-free @fortawesome/free-brands-svg-icons @fortawesome/free-solid-svg-icons @tailwindcss/postcss jwt-decode lodash rxjs tailwindcss tslib @angular/build @angular/cli @angular/compiler-cli @angular/localize @types/lodash istanbul-lib-instrument postcss typescript vitest"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@asteasolutions/epub-reader": "^1.0.4",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/localize": "^22.1.3",
    "@types/lodash": "^4.17.25",
    "istanbul-lib-instrument": "^6.0.3",
    "postcss": "^8.5.26",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
